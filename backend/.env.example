PORT=3000
BOT_TOKEN=your_telegram_bot_token_here
# Lokal ishlab chiqishda Telegramsiz (brauzerda) test qilish uchun true qiling.
# PRODUCTION da albatta false bo'lsin!
DEV_AUTH=false
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
# JWT token imzolash siri — uzun tasodifiy qiymat qo'ying (o'zgarsa hamma foydalanuvchi qayta kiradi)
JWT_SECRET=change_me_to_a_long_random_string
# Production frontend manzil(lar)i CORS uchun — vergul bilan bir nechtasi mumkin
FRONTEND_URL=https://your-site.netlify.app
# Firebase loyiha IDsi — Phone Auth ID tokenlarini tekshirish uchun (shu o'zi yetarli)
FIREBASE_PROJECT_ID=agrozot-db
# Ixtiyoriy: service account JSON (bir qatorda yoki base64) — kengaytirilgan admin amallar uchun
# FIREBASE_SERVICE_ACCOUNT=
# Admin panel kaliti (/#admin sahifasi uchun). Kuchli tasodifiy qiymat qo'ying!
ADMIN_KEY=change_me_to_a_strong_secret
# AI tarif sotib olish uchun Telegram havolasi (Pricing modaldagi tugma)
ADMIN_CONTACT=https://t.me/afaridshop
