generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  telegramId   BigInt?   @unique
  firstName    String?
  lastName     String?
  username     String?
  phone        String?   @unique
  avatarUrl    String?
  aiPlan       String    @default("STANDARD") // AI tarif: STANDARD (bepul, 3 savol) | PRO | PREMIUM
  aiUsageCount Int       @default(0) // jami berilgan AI savollar soni (STANDARD limiti shu bo'yicha)
  isVerified   Boolean   @default(false) // Admin tasdiqlagan profil (ko'k belgi)
  isSupport    Boolean   @default(false) // "Qo'llab-quvvatlash (Admin)" maxsus akkaunti
  aiImagesUsed Int       @default(0) // shu kundagi rasm tahlillari soni
  aiImagesDate String? // hisoblagich qaysi kunga tegishli (YYYY-MM-DD, Toshkent)
  // Onboarding so'rovnomasi javoblari
  surveyRole      String? // farmer | buyer | butcher | curious
  surveyInterests String[] @default([]) // cattle | sheep | horse | rabbit | poultry
  surveySource    String? // instagram | telegram | youtube | friends
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  animals      Animal[]
  messages     Message[]
  chatsA       Chat[]    @relation("ChatUserA")
  chatsB       Chat[]    @relation("ChatUserB")
  reports      Report[]  @relation("Reporter")
  pushSubscriptions PushSubscription[]
}

model Animal {
  id          Int      @id @default(autoincrement())
  title       String
  category    String
  price       Float
  description String?
  images      String[]
  location    String?
  region      String?
  district    String?
  isTop       Boolean  @default(false)
  views       Int      @default(0)
  breed       String?
  age         String?
  gender      String?
  weight      String?
  vaccinated  Boolean?
  attributes  Json?
  status      String   @default("ACTIVE")
  userId      Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])
}

// Chat xabarlari: chatId = null — umumiy xona, aks holda shaxsiy suhbat
model Message {
  id        Int      @id @default(autoincrement())
  type      String   @default("TEXT") // TEXT | IMAGE | VIDEO | AUDIO
  content   String?
  mediaUrl  String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  chatId    Int?
  chat      Chat?    @relation(fields: [chatId], references: [id], onDelete: Cascade)
  readAt    DateTime? // shaxsiy suhbatda sherik o'qigan vaqt (✓✓ uchun)
  isDelivered Boolean @default(true) // serverga yetib bordi (bitta ✓)
  isRead    Boolean  @default(false) // sherik o'qidi (ikkita ✓✓)
  // Reply (javob) — shu xabar qaysi xabarga javoban yozilgan
  replyToId Int?
  replyTo   Message?  @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("MessageReply")
  createdAt DateTime @default(now())

  @@index([chatId, id])
}

// Foydalanuvchi shikoyatlari (Report) — admin panelda ko'riladi va javob beriladi
model Report {
  id         Int      @id @default(autoincrement())
  reporterId Int
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String   @default("OTHER") // ANIMAL | USER | OTHER
  targetId   Int? // e'lon yoki foydalanuvchi IDsi (agar tegishli bo'lsa)
  reason     String // shikoyat matni
  status     String   @default("OPEN") // OPEN | RESOLVED
  adminReply String? // admin javobi (foydalanuvchiga yuborilgan)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, id])
}

// Web Push obunalari (Firebase o'rniga — Service Worker + VAPID)
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// 1-ga-1 shaxsiy suhbat (userAId < userBId — juftlik takrorlanmasligi uchun)
model Chat {
  id        Int       @id @default(autoincrement())
  userAId   Int
  userBId   Int
  userA     User      @relation("ChatUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User      @relation("ChatUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userAId, userBId])
}
